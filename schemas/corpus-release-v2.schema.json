{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folklore-atlas.example/schemas/corpus-release-v2.schema.json",
  "title": "Folklore Corpus Release v2 records",
  "oneOf": [
    { "$ref": "#/$defs/capture" },
    { "$ref": "#/$defs/edition" },
    { "$ref": "#/$defs/document" },
    { "$ref": "#/$defs/witness" },
    { "$ref": "#/$defs/passage" },
    { "$ref": "#/$defs/lineage" },
    { "$ref": "#/$defs/split" },
    { "$ref": "#/$defs/alias" },
    { "$ref": "#/$defs/representation" },
    { "$ref": "#/$defs/derivation" },
    { "$ref": "#/$defs/rights" }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^fa:[a-z-]+:"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capture": {
      "type": "object",
      "required": ["schemaVersion", "id", "capturedAt", "rawPath", "rawSha256", "byteLength"],
      "properties": {
        "schemaVersion": { "const": "folklore-capture-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "edition": {
      "type": "object",
      "required": ["schemaVersion", "id", "captureId", "title", "language"],
      "properties": {
        "schemaVersion": { "const": "folklore-edition-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "captureId": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": ["schemaVersion", "id", "editionId", "title", "language", "captureId", "witnessIds"],
      "properties": {
        "schemaVersion": { "const": "folklore-document-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "editionId": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "captureId": { "$ref": "#/$defs/stableId" },
        "witnessIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": true
    },
    "witness": {
      "type": "object",
      "required": ["schemaVersion", "id", "documentId", "language", "text", "rawPath", "rawSha256"],
      "properties": {
        "schemaVersion": { "const": "folklore-witness-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "documentId": { "$ref": "#/$defs/stableId" },
        "text": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "passage": {
      "type": "object",
      "required": ["schemaVersion", "id", "documentId", "witnessId", "ordinal", "text"],
      "properties": {
        "schemaVersion": { "const": "folklore-passage-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "documentId": { "$ref": "#/$defs/stableId" },
        "witnessId": { "$ref": "#/$defs/stableId" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "required": ["schemaVersion", "outputId", "inputIds", "method", "methodVersion", "rawSha256"],
      "properties": {
        "schemaVersion": { "const": "folklore-lineage-v1" },
        "outputId": { "$ref": "#/$defs/stableId" },
        "inputIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "split": {
      "type": "object",
      "required": ["schemaVersion", "splitId", "documentId", "groupId", "split"],
      "properties": {
        "schemaVersion": { "const": "folklore-split-v1" },
        "split": { "enum": ["train", "validation", "test"] }
      },
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "required": ["schemaVersion", "kind", "alias", "targetId", "reason"],
      "properties": {
        "schemaVersion": { "const": "folklore-alias-v1" },
        "targetId": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": true
    },
    "representation": {
      "type": "object",
      "required": ["schemaVersion", "id", "witnessId", "kind", "language", "artifactId", "artifactPath", "artifactSha256", "byteLength", "mediaType", "derivationId"],
      "properties": {
        "schemaVersion": { "const": "folklore-representation-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "witnessId": { "$ref": "#/$defs/stableId" },
        "kind": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "script": { "type": ["string", "null"] },
        "dialect": { "type": ["string", "null"] },
        "artifactId": { "$ref": "#/$defs/stableId" },
        "artifactPath": { "type": "string", "pattern": "^artifacts/" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "derivationId": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": true
    },
    "derivation": {
      "type": "object",
      "required": ["schemaVersion", "id", "type", "method", "methodVersion", "deterministic", "inputIds", "outputIds"],
      "properties": {
        "schemaVersion": { "const": "folklore-derivation-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["translation", "transliteration", "normalization", "transcription", null] },
        "method": { "type": "string", "minLength": 1 },
        "methodVersion": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "inputIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "outputIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "required": ["schemaVersion", "id", "subjectId", "rightsSource", "attributionText", "jurisdiction", "reviewedOn", "reviewState", "evidenceArtifactId"],
      "properties": {
        "schemaVersion": { "const": "folklore-rights-assessment-v1" },
        "id": { "$ref": "#/$defs/stableId" },
        "subjectId": { "$ref": "#/$defs/stableId" },
        "controlledStatus": {
          "type": ["string", "null"],
          "enum": ["copyrighted", "public-domain", "licensed", "permission", "unknown", null]
        },
        "reviewState": { "enum": ["unreviewed", "accepted", "rejected", "superseded"] },
        "evidenceArtifactId": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": true
    }
  }
}
