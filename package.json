{
  "name": "folklore-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:corpus": "node scripts/build-folklore-corpus.mjs",
    "db:build": "node scripts/build-catalogue.mjs",
    "audit:seed": "node scripts/audit-seed-corpus.mjs",
    "release:pack": "node scripts/release-archive.mjs pack",
    "release:verify": "node scripts/release-archive.mjs verify",
    "validate:release": "node scripts/validate-corpus-release.mjs",
    "test": "vitest run",
    "validate": "npm run build:corpus && npm run audit:seed && npm run validate:release && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "ajv": "8.17.1",
    "vitest": "4.1.10"
  }
}
